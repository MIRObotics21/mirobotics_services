# Move the robot to a voxel of the last GenerateScene (action /plan_and_execute).
# Voxel ids from the GenerateScene json_matrix.
int64 start_voxel_id
int64 goal_voxel_id
---
bool success
string error_msg
---
# Name of the step being executed and progress 0.0 - 1.0
string current_step
float32 progress
