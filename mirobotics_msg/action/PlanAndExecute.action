# Move the TCP above an object or to a point with MoveIt 2 (action /plan_and_execute).
# One joint move from where the robot is, with a fixed tool orientation.
# Object id from the last GenerateScene, the TCP goes hover_height above the object.
# -1 uses goal_point instead.
int64 object_id -1
# TCP target in base_link, in meters.
geometry_msgs/Point goal_point
---
bool success
string error_msg
---
# Name of the step being executed and progress 0.0 - 1.0
string current_step
float32 progress
